# ---- required -------------------------------------------------------------
# Shared password every consumer presents (X-Scheduler-Token). Generate with:
#   openssl rand -base64 32 | tr -d '=+/'
#
# Hand this out only to projects you run. Requests carry their own osu! tokens
# and this service reads the headers it forwards, so anyone whose traffic goes
# through here is trusting you with their osu! token.
SCHEDULER_TOKEN=

# ---- dashboard sign-in ----------------------------------------------------
# How the dashboard authenticates:
#   oauth     osu! OAuth, limited to DASHBOARD_ALLOWED_OSU_IDS
#   password  one shared password, DASHBOARD_PASSWORD
#   none      no check here, because a reverse proxy already does one
# Left empty it is inferred from what you filled in below, and infers `none`
# when that is nothing -- which leaves the dashboard open to anyone who can
# reach it. Set it explicitly.
DASHBOARD_AUTH=oauth
DASHBOARD_PASSWORD=

DASHBOARD_ORIGIN=https://osu-api.example.com
# For DASHBOARD_AUTH=oauth: register an osu! OAuth application at
# https://osu.ppy.sh/home/account/edit with the callback URL set to
# <DASHBOARD_ORIGIN>/auth/callback
DASHBOARD_OSU_CLIENT_ID=
DASHBOARD_OSU_CLIENT_SECRET=
# Comma-separated osu! user ids allowed in. Empty means nobody.
DASHBOARD_ALLOWED_OSU_IDS=

# ---- rate model (optional; defaults match osu!'s documented limits) --------
# Seconds between sends. 1.0 = 60/min sustained, osu!'s documented average.
SCHEDULER_PACE_SECONDS=1.0
# Burst allowance in requests; osu! documents bursts to 1200.
SCHEDULER_BURST_CAPACITY=1200
# Reserved for latency-critical levels so their headroom is actually spendable.
SCHEDULER_GLOBAL_RESERVE=400

# Each level's share of the sustained rate (should sum to 1).
SCHEDULER_SHARE_REALTIME=0.10
SCHEDULER_SHARE_INTERACTIVE=0.10
SCHEDULER_SHARE_HIGH=0.15
SCHEDULER_SHARE_NORMAL=0.35
SCHEDULER_SHARE_BULK=0.30

# Each level's own burst headroom, set independently of its share.
SCHEDULER_BURST_REALTIME=400
SCHEDULER_BURST_INTERACTIVE=300
SCHEDULER_BURST_HIGH=200
SCHEDULER_BURST_NORMAL=150
SCHEDULER_BURST_BULK=100

# ---- bare metal only ------------------------------------------------------
# SCHEDULER_STATE_DIR=/var/lib/osu-api-scheduler
# SCHEDULER_HOST=127.0.0.1
# SCHEDULER_PORT=7654

# ---- optional: delegated sign-in ------------------------------------------
# Use when your osu! application's single callback URL is already taken by
# another site. That site identifies the user and hands back a signed assertion.
# DASHBOARD_HANDOFF_AUTHORIZE_URL=https://osu.ppy.sh/oauth/authorize?client_id=...&redirect_uri=...&response_type=code&scope=identify
# DASHBOARD_HANDOFF_SECRET_FILE=/var/lib/osu-api-scheduler/handoff_secret
