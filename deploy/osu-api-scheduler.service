[Unit]
Description=osu! API scheduler
Documentation=https://github.com/Adrriii/osu-api-scheduler
After=network.target
# The socket unit holds the listening port across restarts, so consumers queue
# rather than get refused. SCHEDULER_HOST/PORT are then unused: the address
# comes from ListenStream in the .socket file.
Requires=osu-api-scheduler.socket
After=osu-api-scheduler.socket

[Service]
Type=simple
User=osu-api-scheduler
Group=osu-api-scheduler
WorkingDirectory=/opt/osu-api-scheduler
EnvironmentFile=/etc/osu-api-scheduler/scheduler.env

# tsx as an ESM loader: the server runs from TypeScript source, so what is
# deployed is what you can read.
ExecStart=/usr/bin/env node --import tsx server/src/index.ts

# Everything else on the host waits on this one, so come back fast.
Restart=always
RestartSec=2
# SIGTERM drains the queue rather than failing it, so stopping takes as long as
# serving what was already accepted. Must exceed SCHEDULER_SHUTDOWN_GRACE_MS
# (25s by default) or systemd kills the process mid-drain.
TimeoutStopSec=40

# Hardening. The scheduler needs outbound network, its state directory, and
# nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/osu-api-scheduler
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=osu-api-scheduler

[Install]
WantedBy=multi-user.target
